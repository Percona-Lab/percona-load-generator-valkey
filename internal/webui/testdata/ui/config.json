{
  "credentials_from_env": false,
  "defaults": {
    "dataset": {
      "bitmap_bits": 10000,
      "collection_size": 100,
      "hash_fields": 8,
      "hash_tag_groups": 0,
      "key_count": 100000,
      "key_distribution": "uniform",
      "key_prefix": "plgv:",
      "preload": true,
      "stream_length": 20,
      "ttl": {
        "fraction": 1,
        "max_seconds": 3600,
        "min_seconds": 60,
        "mode": "none",
        "seconds": 300
      },
      "value_size": 256,
      "zipf_s": 0
    },
    "keyspace_analysis": {
      "enabled": false,
      "match": "",
      "samples": 10000,
      "top": 10
    },
    "output": {
      "sample_interval": "1s",
      "summary_file": ""
    },
    "record": {
      "backpressure": "fail",
      "checksums": false,
      "compression": "auto",
      "data_fingerprint": true,
      "max_mb": 0,
      "outcomes": false,
      "path": ""
    },
    "run": {
      "concurrency": 64,
      "coordinated_omission": false,
      "deterministic": false,
      "duration": "10s",
      "load_profile": {
        "base_workers": 0,
        "end_workers": 0,
        "kind": "fixed",
        "max_workers": 0,
        "min_workers": 0,
        "peak_workers": 0,
        "period": "",
        "ramp_over": "",
        "spike_at": "",
        "spike_for": "",
        "start_workers": 0,
        "steps": [],
        "workers": 0
      },
      "loop": "closed",
      "op_budget": 0,
      "seed": 1,
      "sweep": {
        "kind": "none",
        "pause": "0s",
        "values": []
      },
      "target_ops_per_sec": 0
    },
    "server_metrics": {
      "enabled": false,
      "interval": "1s",
      "latency": true,
      "slowlog": true,
      "slowlog_entries": 128
    },
    "target": {
      "client": "valkey-go",
      "mode": "auto",
      "pool": {
        "pipeline_depth": 1
      },
      "read_from_replicas": false,
      "sentinel": {
        "master_name": ""
      },
      "tls": {
        "ca_file": "",
        "cert_file": "",
        "enabled": false,
        "insecure_skip_verify": false,
        "key_file": "",
        "server_name": ""
      },
      "uris": [
        "valkey://127.0.0.1:6379"
      ]
    },
    "workload": {
      "allow_dangerous": false,
      "mix": [
        {
          "op": "GET",
          "weight": 80
        },
        {
          "op": "SET",
          "weight": 20
        }
      ],
      "pubsub": {
        "channels": 16,
        "sharded": false,
        "subscribers": 0
      }
    }
