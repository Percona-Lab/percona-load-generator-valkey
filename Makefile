APP_NAME := plgv
SRC_DIR := ./cmd/plgv
BIN_DIR := bin
COMPOSE ?= docker compose

VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
LDFLAGS := -ldflags "-s -w -X main.version=$(VERSION)"

.PHONY: all build dist docker-build build-local clean run web help \
	test test-unit test-race test-integration test-ui fmt vet check qa \
	valkey-up valkey-down valkey-cluster-up valkey-cluster-down valkey-sentinel-up valkey-sentinel-down valkey-tls-up valkey-tls-down test-integration-tls test-soak valkey-cli valkey-logs test-integration-cluster test-integration-sentinel

all: build-local

# --- Build ---

# Release archives for every platform: bin/plgv-<version>-<os>-<arch>.tar.gz with the
# binary, LICENSE, THIRD_PARTY.md and README.md, plus bin/SHA256SUMS.
PLATFORMS := linux/amd64 linux/arm64 darwin/amd64 darwin/arm64

build: clean dist
	@echo "All builds complete. Artifacts are in $(BIN_DIR)/"

dist:
	@mkdir -p $(BIN_DIR)
	@set -e; for p in $(PLATFORMS); do \
		os=$${p%/*}; arch=$${p#*/}; name=$(APP_NAME)-$(VERSION)-$$os-$$arch; \
		echo "building $$name"; \
		rm -rf $(BIN_DIR)/$$name; mkdir -p $(BIN_DIR)/$$name; \
		CGO_ENABLED=0 GOOS=$$os GOARCH=$$arch go build -trimpath $(LDFLAGS) -o $(BIN_DIR)/$$name/$(APP_NAME) $(SRC_DIR); \
		cp LICENSE THIRD_PARTY.md README.md $(BIN_DIR)/$$name/; \
		tar -czf $(BIN_DIR)/$$name.tar.gz -C $(BIN_DIR) $$name; \
		rm -rf $(BIN_DIR)/$$name; \
	done
	cd $(BIN_DIR) && (sha256sum *.tar.gz 2>/dev/null || shasum -a 256 *.tar.gz) > SHA256SUMS
	@cat $(BIN_DIR)/SHA256SUMS

docker-build:
	docker build -t $(APP_NAME):$(VERSION) --build-arg VERSION=$(VERSION) .

build-local:
	@mkdir -p $(BIN_DIR)
	go build $(LDFLAGS) -o $(BIN_DIR)/$(APP_NAME) $(SRC_DIR)

clean:
	go clean -cache -testcache
	@find $(BIN_DIR) -mindepth 1 -delete 2>/dev/null || true

run: build-local
	@./$(BIN_DIR)/$(APP_NAME) help

web: build-local
	./$(BIN_DIR)/$(APP_NAME) web

# --- Testing / QA ---

test-unit:
	go test ./...

test: test-unit

test-race:
	go test -race ./...

# Packages run one at a time (-p 1): they share one server, and tests compare
# client and server operation counts, which other traffic would disturb.
# Needs a reachable Valkey (make valkey-up; cluster tests also need make valkey-cluster-up).
# Override with: make test-integration PLGV_IT_VALKEY_ADDR=host:port
PLGV_IT_VALKEY_ADDR ?= 127.0.0.1:6379
test-integration:
	PLGV_IT_VALKEY_ADDR=$(PLGV_IT_VALKEY_ADDR) go test -p 1 -tags=integration ./... -v

# Cluster and sentinel tests need their own environments (make valkey-cluster-up,
# make valkey-sentinel-up) and include a forced failover; the topology is put back
# afterwards. They are separate from test-integration so a plain checkout with
# only the standalone server still passes it.
PLGV_IT_CLUSTER_ADDR ?= 127.0.0.1:7001
test-integration-cluster:
	PLGV_IT_CLUSTER_ADDR=$(PLGV_IT_CLUSTER_ADDR) go test -p 1 -tags=integration_cluster ./internal/session ./internal/webui -v -count=1

# TLS + ACL tests need make valkey-tls-up.
PLGV_IT_TLS_ADDR ?= 127.0.0.1:6444
test-integration-tls:
	PLGV_IT_TLS_ADDR=$(PLGV_IT_TLS_ADDR) PLGV_IT_TLS_DIR=$(CURDIR)/.test-certs go test -p 1 -tags=integration_tls ./internal/session -v -count=1

# Soak: one long run and many short ones, memory and goroutines must stay flat. Needs make valkey-up.
# The plan's soak is 24h: PLGV_SOAK_DURATION=24h make test-soak (default 2m).
PLGV_SOAK_DURATION ?= 2m
test-soak:
	PLGV_SOAK_DURATION=$(PLGV_SOAK_DURATION) PLGV_IT_VALKEY_ADDR=$(PLGV_IT_VALKEY_ADDR) go test -p 1 -tags=integration,soak -run 'TestSoak' -timeout 0 ./internal/session -v -count=1

PLGV_IT_SENTINEL_ADDRS ?= 127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
test-integration-sentinel:
	PLGV_IT_SENTINEL_ADDRS=$(PLGV_IT_SENTINEL_ADDRS) go test -p 1 -tags=integration_sentinel ./internal/session -v -count=1

# Web UI DOM tests (jsdom) against fixtures generated by the Go tests. Needs
# Node.js 20+ and npm; fails rather than skipping when they are missing.
# Regenerate fixtures: go test ./internal/webui -run TestUIFixturesMatchAPI -update-ui-fixtures
test-ui:
	@command -v node >/dev/null || { echo "test-ui: node is not installed"; exit 1; }
	cd internal/webui/uitest && npm ci --no-audit --no-fund && npm test

fmt:
	@unformatted=$$(gofmt -l ./internal ./cmd); \
	if [ -n "$$unformatted" ]; then \
		echo "These files are not gofmt-clean:"; echo "$$unformatted"; exit 1; \
	else echo "gofmt clean."; fi

vet:
	go vet ./...

check: fmt vet test-unit
	@echo "All checks passed."

qa: check

# --- Local Valkey (see VALKEY_TEST_ENV.md) ---

valkey-up:
	$(COMPOSE) up -d --wait valkey
	@echo "Valkey standalone: 127.0.0.1:6379"

valkey-down:
	$(COMPOSE) down -v --remove-orphans

valkey-cluster-up:
	$(COMPOSE) --profile cluster up -d valkey-c1 valkey-c2 valkey-c3 valkey-c4 valkey-c5 valkey-c6
	$(COMPOSE) --profile cluster run --rm valkey-cluster-init
	@# Wait until every node agrees the cluster is ok and each replica is synced.
	@for i in $$(seq 1 60); do \
	  ok=0; \
	  for p in 7001 7002 7003 7004 7005 7006; do \
	    info=$$(docker exec plgv-valkey-c1 valkey-cli -p $$p cluster info 2>/dev/null); \
	    echo "$$info" | grep -q 'cluster_state:ok' && echo "$$info" | grep -q 'cluster_known_nodes:6' && ok=$$((ok+1)); \
	    rep=$$(docker exec plgv-valkey-c1 valkey-cli -p $$p info replication 2>/dev/null); \
	    if echo "$$rep" | grep -q 'role:slave'; then echo "$$rep" | grep -q 'master_link_status:up' && ok=$$((ok+1)) || true; else ok=$$((ok+1)); fi; \
	  done; \
	  [ $$ok -eq 12 ] && break; sleep 1; \
	done; [ $$ok -eq 12 ] || { echo "cluster did not become ready"; exit 1; }
	@echo "Valkey cluster: 127.0.0.1:7001-7006"

valkey-cluster-down:
	$(COMPOSE) --profile cluster down -v --remove-orphans

valkey-sentinel-up:
	$(COMPOSE) --profile sentinel up -d --wait sentinel-primary
	$(COMPOSE) --profile sentinel up -d sentinel-replica sentinel-1 sentinel-2 sentinel-3
	@# Wait until every sentinel knows the master and has seen the replica and the other sentinels.
	@for i in $$(seq 1 60); do \
	  ok=0; \
	  for p in 26379 26380 26381; do \
	    m=$$(docker exec plgv-sentinel-primary valkey-cli -p $$p sentinel master mymaster 2>/dev/null); \
	    echo "$$m" | grep -qx 'num-slaves' && echo "$$m" | grep -A1 -x 'num-slaves' | tail -1 | grep -qx 1 && \
	      echo "$$m" | grep -A1 -x 'num-other-sentinels' | tail -1 | grep -qx 2 && ok=$$((ok+1)); \
	  done; \
	  [ $$ok -eq 3 ] && break; sleep 1; \
	done; [ $$ok -eq 3 ] || { echo "sentinel did not become ready"; exit 1; }
	@echo "Valkey sentinel: primary 127.0.0.1:6380, replica 6381, sentinels 26379-26381 (master set mymaster)"

valkey-sentinel-down:
	$(COMPOSE) --profile sentinel down -v --remove-orphans

valkey-tls-up:
	./scripts/gen-test-certs.sh
	$(COMPOSE) --profile tls up -d --wait valkey-tls
	@echo "Valkey TLS + ACL: 127.0.0.1:6444 (certificates in .test-certs/, users in testdata/acl/users.acl)"

valkey-tls-down:
	$(COMPOSE) --profile tls rm -sfv valkey-tls

valkey-cli:
	docker exec -it plgv-valkey valkey-cli

valkey-logs:
	$(COMPOSE) logs -f

help:
	@echo "plgv make targets:"
	@echo "  build-local       build bin/plgv"
	@echo "  web               start the web UI on 127.0.0.1:8080"
	@echo "  build / dist      release archives (linux and mac, amd64 and arm64) and SHA256SUMS"
	@echo "  docker-build      build the container image"
	@echo "  check             fmt + vet + unit tests"
	@echo "  test-race         unit tests with -race"
	@echo "  test-integration  needs make valkey-up"
	@echo "  test-integration-cluster / -sentinel  need make valkey-cluster-up / valkey-sentinel-up"
	@echo "  test-ui           web UI DOM tests (needs Node.js)"
	@echo "  valkey-up / valkey-down / valkey-cluster-up / valkey-cluster-down / valkey-cli / valkey-logs"
